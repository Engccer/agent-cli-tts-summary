{
  "_comment": "Windows Claude Code용 hooks 발췌 샘플. macOS는 claude.macos.settings.json을 쓴다. ~/.claude/settings.json의 hooks 키 아래에 병합한다. <USER_HOME>를 실제 홈 경로로 치환한 뒤 사용한다(예: C:\\Users\\이름). 그대로 붙여넣지 말 것. PreToolUse 블록(질문 선택지 음성 안내)은 선택이며 설정 파일의 interim=on일 때만 발화한다. UserPromptSubmit 블록(설정의 사용 여부·상세 정도 통지)은 선택이지만, verbosity 설정을 실제로 쓰려면 필요하다.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<USER_HOME>\\.claude\\hooks-windows\\stop-tts.ps1\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<USER_HOME>\\.claude\\hooks-windows\\ask-question-tts.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<USER_HOME>\\.claude\\hooks-windows\\tts-config-context.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
