{
  "_comment": "Windows Codex CLI용 hooks 등록 샘플 (~/.codex/hooks.json). macOS는 codex.macos.hooks.json을 쓴다. <USER_HOME>를 실제 홈 경로로 치환한 뒤 사용한다(예: C:\\Users\\이름). 그대로 붙여넣지 말 것. PreToolUse matcher는 Codex의 선택 질문 도구명 request_user_input을 쓰며(Claude의 AskUserQuestion과 다름), 블록은 선택이고 설정 파일의 interim=on일 때만 발화한다. UserPromptSubmit은 tts-config-context.ps1의 Codex JSON 출력을 매 턴 추가 컨텍스트로 전달한다. 설치 시 AgentDirName을 .codex로 지정하고 새 훅의 신뢰 상태를 확인한다.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<USER_HOME>\\.codex\\hooks-windows\\stop-tts.ps1\"",
            "timeout": 300,
            "statusMessage": "Playing Codex TTS summary"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "request_user_input",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<USER_HOME>\\.codex\\hooks-windows\\ask-question-tts.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"<USER_HOME>\\.codex\\hooks-windows\\tts-config-context.ps1\"",
            "timeout": 10,
            "statusMessage": "Loading Codex TTS settings"
          }
        ]
      }
    ]
  }
}
